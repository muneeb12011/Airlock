# PostgreSQL connection (Neon, Render, local, etc.)
DATABASE_URL=postgresql://neondb_owner:npg_m5zjCOqx1RWX@ep-still-lab-aynzt14w-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require/taskmanager/taskmanager

# Secret used to sign JWTs - make this long and random
JWT_SECRET=change_this_to_a_long_random_string

# How long a login session stays valid
JWT_EXPIRES_IN=8h

PORT=7860

# Your Vercel frontend URL, e.g. https://taskmanager.vercel.app
# Locks CORS down so only your frontend can call this API.
FRONTEND_URL=

# Comma-separated list of IPs allowed to hit the admin export/download routes.
# Leave blank to allow any IP that has a valid admin login (not recommended for production).
# Example for an office network + your home IP:
# ADMIN_ALLOWED_IPS=203.0.113.10,203.0.113.11
ADMIN_ALLOWED_IPS=

# Where uploaded submission files are stored on disk
UPLOAD_DIR=uploads
